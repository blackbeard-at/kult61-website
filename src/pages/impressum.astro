---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumb } from '../lib/seo';
import { SITE } from '../config/site';

const op = SITE.operator;
---

<BaseLayout
  title="Impressum | KULT61 Hanau-Großauheim"
  description="Impressum und Anbieterkennzeichnung des KULT61, Hanauer Landstraße 61, 63457 Hanau-Großauheim."
  path="/impressum"
  jsonLd={[breadcrumb([['Impressum', '/impressum']])]}
>
  <section class="page-hero">
    <h1>Impressum</h1>
  </section>

  <div class="prose">
    <h2 style="margin-top: 0">Diensteanbieter</h2>
    <address>
      {op.name}<br />
      {op.street}<br />
      {op.zip} {op.city}<br />
      {op.country}
    </address>

    <h2>Vertretungsberechtigt</h2>
    <p>
      Persönlich haftende Gesellschafterin: <em>wird nachgereicht</em><br />
      Vertreten durch die Geschäftsführung: <em>wird nachgereicht</em>
    </p>

    <h2>Kontaktmöglichkeiten</h2>
    <p>E-Mail-Adresse: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>

    <h2>Angaben zum Unternehmen</h2>
    <p>Umsatzsteuer-Identifikationsnummer (USt-ID): {op.vatId}</p>

    <h2>Standort der Veranstaltungsräume</h2>
    <address>
      KULT61<br />
      {SITE.address.street}<br />
      {SITE.address.zip} {SITE.address.city}
    </address>

    <h2>Streitschlichtung und Verbraucherstreitbeilegung</h2>
    <p>Die frühere EU-Plattform zur Online-Streitbeilegung (OS-Plattform) steht nicht mehr zur Verfügung.</p>
    <p>Wir sind zur Beilegung von Streitigkeiten mit Verbrauchern vor einer Verbraucherschlichtungsstelle bereit.</p>
  </div>
</BaseLayout>
