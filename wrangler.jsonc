// Cloudflare Workers (statische Assets): liefert den Astro-Build aus dist/ aus.
// Build-Befehl in Cloudflare: npm run build — Deploy: npx wrangler deploy
{
  "name": "kult61-website",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    // Unbekannte URLs bekommen src/pages/404.astro (dist/404.html) mit Status 404
    "not_found_handling": "404-page"
  }
}
